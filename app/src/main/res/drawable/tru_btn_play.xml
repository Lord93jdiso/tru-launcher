<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#a9822a" android:centerColor="#96701c" android:endColor="#6f5212" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#e8c56a" android:centerColor="#d4af37" android:endColor="#a9822a" />
            <stroke android:width="1dp" android:color="#f1d07a" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
